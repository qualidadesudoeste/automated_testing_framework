{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Resultado de agente especialista QA",
  "type": "object",
  "required": ["agent", "status", "summary", "coverage", "findings", "artifacts"],
  "properties": {
    "agent": {"type": "string"},
    "status": {"const": "complete"},
    "summary": {"type": "string", "minLength": 1},
    "coverage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "status"],
        "properties": {
          "id": {"type": "string"},
          "status": {"enum": ["complete", "blocked", "not_applicable"]},
          "evidence": {"type": "array", "items": {"type": "string"}},
          "reason": {"type": "string"}
        }
      }
    },
    "findings": {"type": "array", "items": {"type": "object"}},
    "artifacts": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
